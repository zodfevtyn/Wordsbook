<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wordsbook.Controls.WordEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wordsbook.Controls"
    xmlns:vm="using:Wordsbook.ViewModels">

    <Border
        Background="{ThemeResource DialogBg}"
        BorderBrush="{ThemeResource DialogStroke}"
        BorderThickness="1"
        CornerRadius="{StaticResource RDialog}"
        Padding="22,16,22,20">

        <!-- 窗口矮或缩放高时卡片会比可视区还高，底部圆角就会被窗口切掉；限高后先滚动。 -->
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <StackPanel Margin="0,0,12,0" Spacing="10">

                <Grid Margin="0,0,0,2">
                    <TextBlock
                        x:Name="TitleText"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource AppDisplayFont}"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimary}"
                        Text="New word" />
                    <Button
                        x:Name="CloseButton"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close"
                        VerticalAlignment="Center"
                        Background="{ThemeResource Accent}"
                        BorderThickness="0"
                        Click="OnCancel"
                        Content="&#xE711;"
                        FontFamily="{StaticResource AppIconFont}"
                        FontSize="10"
                        Foreground="White"
                        CornerRadius="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,84" ColumnSpacing="9">
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="WORD" />
                        <Border x:Name="WordHost" Style="{StaticResource PillHost}">
                            <TextBox
                                x:Name="WordBox"
                                FontFamily="{StaticResource AppRoundFont}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                PlaceholderText="word   *"
                                Style="{StaticResource PillTextBox}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="NATURE" />
                        <Border Style="{StaticResource PillHost}">
                            <TextBox
                                x:Name="NatureBox"
                                HorizontalContentAlignment="Center"
                                PlaceholderText="de / het"
                                Style="{StaticResource PillTextBox}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="MEANINGS" />
                    <Border x:Name="MeaningHost" Style="{StaticResource PillHost}">
                        <TextBox
                            x:Name="MeaningBox"
                            PlaceholderText="meaning   *"
                            Style="{StaticResource PillTextBox}" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PRONUNCIATION" />
                    <Border Style="{StaticResource PillHost}">
                        <TextBox
                            x:Name="PronBox"
                            PlaceholderText="/prəˌnʌnsiˈeɪʃən/"
                            Style="{StaticResource PillTextBox}" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="VARIANTS" />
                    <Grid ColumnDefinitions="*,118,26" ColumnSpacing="8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="FORM" />
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="NATURE" />
                    </Grid>
                    <ItemsControl x:Name="RelatedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RelatedRow">
                                <Grid
                                    Margin="0,0,0,8"
                                    ColumnDefinitions="*,118,26"
                                    ColumnSpacing="8">
                                    <Border Style="{StaticResource PillHost}">
                                        <TextBox
                                            PlaceholderText="form"
                                            Style="{StaticResource PillTextBox}"
                                            Text="{x:Bind Form, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource PillHost}">
                                        <TextBox
                                            PlaceholderText="usage"
                                            Style="{StaticResource PillTextBox}"
                                            Text="{x:Bind Nature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Remove variant"
                                        Click="OnRemoveRelated"
                                        Content="&#xE8BB;"
                                        FontSize="9"
                                        Style="{StaticResource TinyIconButton}"
                                        Tag="{x:Bind}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,118,26" ColumnSpacing="8">
                        <Border Style="{StaticResource PillHost}">
                            <TextBox
                                x:Name="AddRelatedBox"
                                KeyDown="OnAddRelatedKeyDown"
                                PlaceholderText="Add form"
                                Style="{StaticResource PillTextBox}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PillHost}">
                            <TextBox
                                x:Name="AddNatureBox"
                                KeyDown="OnAddRelatedKeyDown"
                                PlaceholderText="usage"
                                Style="{StaticResource PillTextBox}" />
                        </Border>
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Add variant"
                            Click="OnAddRelated"
                            Content="&#xE710;"
                            Style="{StaticResource AddChipButton}"
                            ToolTipService.ToolTip="Add variant"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="DESCRIPTIONS" />
                    <Border Style="{StaticResource NoteHost}">
                        <TextBox
                            x:Name="DescriptionBox"
                            PlaceholderText="one sentence per line"
                            Style="{StaticResource NoteTextBox}" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="CATEGORIES" />
                    <ItemsControl
                        x:Name="CategoryChips"
                        HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryChip">
                                <Grid>
                                    <ToggleButton
                                        Content="{x:Bind Name}"
                                        IsChecked="{x:Bind On, Mode=TwoWay}"
                                        Style="{StaticResource CategoryChipButton}"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind ChipVisibility}" />
                                    <Button
                                        AutomationProperties.Name="New category"
                                        Click="OnAddCategoryChip"
                                        Content="&#xE710;"
                                        Style="{StaticResource AddChipButton}"
                                        ToolTipService.ToolTip="New category"
                                        Visibility="{x:Bind AddVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="DATE" />
                    <Button
                        x:Name="DateButton"
                        AutomationProperties.Name="Word date"
                        Style="{StaticResource DateFieldButton}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <FontIcon
                                FontSize="13"
                                Foreground="{ThemeResource TextSecondary}"
                                Glyph="&#xE787;" />
                            <TextBlock
                                x:Name="DateText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppTextFont}"
                                FontSize="14"
                                Foreground="{ThemeResource FieldFg}"
                                Text="Oct 26, 2026" />
                            <FontIcon
                                Grid.Column="2"
                                FontSize="9"
                                Foreground="{ThemeResource TextTertiary}"
                                Glyph="&#xE70D;" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout
                                x:Name="DateFlyout"
                                FlyoutPresenterStyle="{StaticResource DateFlyoutPresenter}"
                                Opening="OnDateFlyoutOpening"
                                Placement="Top">
                                <CalendarView
                                    x:Name="DateCalendar"
                                    HorizontalAlignment="Center"
                                    IsTodayHighlighted="True"
                                    Language="en-US"
                                    SelectedDatesChanged="OnDateSelected"
                                    SelectionMode="Single" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PROGRAM" />
                    <Border
                        Padding="3"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SegmentTrack}"
                        CornerRadius="17">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                x:Name="MarkOk"
                                Content="&#xE73E;"
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="13"
                                GroupName="Mark"
                                Style="{StaticResource SegmentItem}" />
                            <RadioButton
                                x:Name="MarkUnknown"
                                Content="?"
                                FontFamily="{StaticResource AppDisplayFont}"
                                FontSize="14"
                                FontWeight="Semibold"
                                GroupName="Mark"
                                Style="{StaticResource SegmentItem}" />
                            <RadioButton
                                x:Name="MarkWarn"
                                Content="!"
                                FontFamily="{StaticResource AppDisplayFont}"
                                FontSize="14"
                                FontWeight="Semibold"
                                GroupName="Mark"
                                Style="{StaticResource SegmentItem}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button
                    x:Name="OkButton"
                    Width="30"
                    Height="30"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Save word"
                    Background="#34C759"
                    BorderThickness="0"
                    Click="OnConfirm"
                    Content="&#xE73E;"
                    FontFamily="{StaticResource AppIconFont}"
                    FontSize="12"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
