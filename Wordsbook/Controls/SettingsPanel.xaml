<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wordsbook.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{ThemeResource DialogBg}"
        BorderBrush="{ThemeResource DialogStroke}"
        BorderThickness="1"
        CornerRadius="{StaticResource RDialog}"
        Padding="24,20,24,22">

        <StackPanel Width="340" Spacing="16">

            <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource AppDisplayFont}"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimary}"
                    Text="Settings" />
                <Button
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource Accent}"
                    Click="OnClose"
                    Content="&#xE711;"
                    FontFamily="{StaticResource AppIconFont}"
                    FontSize="10"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock
                    FontFamily="{StaticResource AppTextFont}"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondary}"
                    Text="Appearance" />
                <Border
                    Background="{ThemeResource SegmentTrack}"
                    CornerRadius="17"
                    Padding="3">
                    <Grid ColumnDefinitions="*,*,*">
                        <RadioButton
                            x:Name="ThemeSystem"
                            Checked="OnThemeChanged"
                            Content="System"
                            GroupName="Theme"
                            Style="{StaticResource SegmentItem}" />
                        <RadioButton
                            x:Name="ThemeLight"
                            Grid.Column="1"
                            Checked="OnThemeChanged"
                            Content="Light"
                            GroupName="Theme"
                            Style="{StaticResource SegmentItem}" />
                        <RadioButton
                            x:Name="ThemeDark"
                            Grid.Column="2"
                            Checked="OnThemeChanged"
                            Content="Dark"
                            GroupName="Theme"
                            Style="{StaticResource SegmentItem}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    FontFamily="{StaticResource AppTextFont}"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondary}"
                    Text="Zoom" />
                <Border
                    Background="{ThemeResource SegmentTrack}"
                    CornerRadius="17"
                    Padding="3">
                    <Grid ColumnDefinitions="*,*,*">
                        <RadioButton
                            x:Name="Scale1"
                            Checked="OnScaleChanged"
                            Content="1x"
                            GroupName="Scale"
                            Style="{StaticResource SegmentItem}" />
                        <RadioButton
                            x:Name="Scale125"
                            Grid.Column="1"
                            Checked="OnScaleChanged"
                            Content="1.25x"
                            GroupName="Scale"
                            Style="{StaticResource SegmentItem}" />
                        <RadioButton
                            x:Name="Scale15"
                            Grid.Column="2"
                            Checked="OnScaleChanged"
                            Content="1.5x"
                            GroupName="Scale"
                            Style="{StaticResource SegmentItem}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    FontFamily="{StaticResource AppTextFont}"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondary}"
                    Text="Font (restart to apply)" />
                <Border
                    Background="{ThemeResource SegmentTrack}"
                    CornerRadius="17"
                    Padding="3">
                    <Grid ColumnDefinitions="*,*">
                        <RadioButton
                            x:Name="FontSf"
                            Checked="OnFontChanged"
                            Content="SF Pro"
                            GroupName="Font"
                            Style="{StaticResource SegmentItem}" />
                        <RadioButton
                            x:Name="FontSystem"
                            Grid.Column="1"
                            Checked="OnFontChanged"
                            Content="System"
                            GroupName="Font"
                            Style="{StaticResource SegmentItem}" />
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
