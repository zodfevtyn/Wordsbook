<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wordsbook.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wordsbook.Controls"
    xmlns:models="using:Wordsbook.Models"
    xmlns:vm="using:Wordsbook.ViewModels">

    <!-- Mica 只是给半透明遮罩（EditorScrim / SettingsScrim）当底：没有 SystemBackdrop
         时它们透过去看到的是黑底而不是桌面。四角和它无关，那是 ApplyCornerRegion
         用 SetWindowRgn 把窗口区域本身切掉的。 -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <!-- 缩放宿主：窗口给足物理尺寸，RootGrid 反向缩小布局再整体放大渲染 -->
    <Grid x:Name="ZoomHost" SizeChanged="OnZoomHostResized">
        <Grid
            x:Name="RootGrid"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Loaded="OnRootLoaded"
            PointerMoved="OnRootPointerMoved"
            PointerReleased="OnRootPointerReleased"
            PreviewKeyDown="OnRootPreviewKeyDown"
            RenderTransformOrigin="0,0">

            <Grid.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.Resources>

                <ItemsPanelTemplate x:Key="WrapPanelTemplate">
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="252" />
                </ItemsPanelTemplate>
                <ItemsPanelTemplate x:Key="StackPanelTemplate">
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
                <ItemsPanelTemplate x:Key="MasonryPanelTemplate">
                    <controls:MasonryPanel MinItemWidth="280" Spacing="16" />
                </ItemsPanelTemplate>

                <!-- 日期分组头：默认模板自带 1px 分隔线，这里只留内容 -->
                <Style x:Key="WordGroupHeaderContainer" TargetType="ListViewHeaderItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewHeaderItem">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <DataTemplate x:Key="WordGroupHeaderTemplate" x:DataType="vm:WordGroup">
                    <TextBlock
                        Margin="12,10,0,8"
                        FontFamily="{StaticResource AppTextFont}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextSecondary}"
                        Text="{x:Bind Title}"
                        Visibility="{x:Bind HeaderVisibility}" />
                </DataTemplate>

                <!-- 目录树里的小箭头：独立按钮，避免和“选中”抢一次点击 -->
                <Style x:Key="ChevronButton" TargetType="Button">
                    <Setter Property="Width" Value="18" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontFamily" Value="{StaticResource AppIconFont}" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 侧栏：日 -->
                <DataTemplate x:Key="DayTemplate" x:DataType="vm:DayNode">
                    <ToggleButton
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="20,0,0,0"
                        Click="OnDayClick"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                        Style="{StaticResource SidebarRow}"
                        Tag="{x:Bind Key}">
                        <Grid ColumnDefinitions="16,*,Auto">
                            <TextBlock
                                FontFamily="{StaticResource AppTextFont}"
                                FontSize="12"
                                Foreground="{ThemeResource TextTertiary}"
                                Text="–"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Foreground="{ThemeResource TextPrimary}"
                                Text="{x:Bind Label, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                FontFamily="{StaticResource AppDisplayFont}"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{ThemeResource Accent}"
                                Text="{x:Bind Count, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                </DataTemplate>

                <!-- 侧栏：年月 -->
                <DataTemplate x:Key="MonthTemplate" x:DataType="vm:MonthNode">
                    <StackPanel>
                        <Grid Margin="6,0,0,0">
                            <ToggleButton
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnMonthClick"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                Style="{StaticResource SidebarRow}"
                                Tag="{x:Bind Key}">
                                <Grid ColumnDefinitions="16,*,Auto,24">
                                    <Ellipse
                                        Width="6"
                                        Height="6"
                                        Fill="{ThemeResource Accent}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextPrimary}"
                                        Text="{x:Bind Label, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,4,0"
                                        FontFamily="{StaticResource AppDisplayFont}"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource TextSecondary}"
                                        Text="{x:Bind Stat, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <Button
                                Width="18"
                                Margin="0,0,9,0"
                                HorizontalAlignment="Right"
                                Click="OnMonthChevron"
                                Content="{x:Bind Chevron, Mode=OneWay}"
                                Style="{StaticResource ChevronButton}"
                                Tag="{x:Bind Key}" />
                        </Grid>
                        <ItemsControl
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Margin="6,0,0,0"
                            ItemTemplate="{StaticResource DayTemplate}"
                            ItemsSource="{x:Bind Days}"
                            Visibility="{x:Bind ChildrenVisibility, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>

                <!-- 侧栏：语言 -->
                <DataTemplate x:Key="LangTemplate" x:DataType="vm:LangNode">
                    <StackPanel>
                        <Grid>
                            <ToggleButton
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnLanguageClick"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                RightTapped="OnLanguageRightTapped"
                                Style="{StaticResource SidebarRow}"
                                Tag="{x:Bind Id}">
                                <Grid ColumnDefinitions="28,*,Auto,24">
                                    <ContentControl
                                        Content="{x:Bind FlagVisual, Mode=OneWay}"
                                        IsTabStop="False"
                                        Padding="0"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontFamily="{StaticResource AppDisplayFont}"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource TextPrimary}"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,4,0"
                                        FontFamily="{StaticResource AppDisplayFont}"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource TextPrimary}"
                                        Text="{x:Bind Count, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <!-- 叠在整行之上而不是塞进 ToggleButton：嵌进去的按钮拿不到点击 -->
                            <Button
                                Width="18"
                                Margin="0,0,9,0"
                                HorizontalAlignment="Right"
                                Click="OnLanguageChevron"
                                Content="{x:Bind Chevron, Mode=OneWay}"
                                Style="{StaticResource ChevronButton}"
                                Tag="{x:Bind Id}" />
                        </Grid>
                        <ItemsControl
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Margin="8,0,0,0"
                            ItemTemplate="{StaticResource MonthTemplate}"
                            ItemsSource="{x:Bind Months}"
                            Visibility="{x:Bind ChildrenVisibility, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>

                <!-- 侧栏：分类 -->
                <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:CategoryNode">
                    <ToggleButton
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="20,0,0,0"
                        Click="OnCategoryClick"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                        Style="{StaticResource SidebarRow}"
                        Tag="{x:Bind Id}">
                        <Grid ColumnDefinitions="20,*,Auto">
                            <!-- 选中行换实心标签 + 主题色。两层叠在一起只切可见性，颜色才能继续吃 ThemeResource。 -->
                            <TextBlock
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="13"
                                Foreground="{ThemeResource TextTertiary}"
                                Text="&#x1002E1;"
                                Visibility="{x:Bind TagOutlineVisibility, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="13"
                                Foreground="{ThemeResource Accent}"
                                Text="&#x1002E2;"
                                Visibility="{x:Bind TagFillVisibility, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="13"
                                Foreground="{ThemeResource TextPrimary}"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                FontFamily="{StaticResource AppDisplayFont}"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{ThemeResource Accent}"
                                Text="{x:Bind Count, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                </DataTemplate>

                <DataTemplate x:Key="CategoryGroupTemplate" x:DataType="vm:CategoryGroupNode">
                    <StackPanel>
                        <!-- 分组行整行可点，箭头只是状态指示，所以不另设按钮 -->
                        <ToggleButton
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="OnCategoryGroupChevron"
                            IsChecked="False"
                            Style="{StaticResource SidebarRow}"
                            Tag="{x:Bind Id}">
                            <Grid ColumnDefinitions="28,*,Auto,24">
                                <ContentControl
                                    Content="{x:Bind FlagVisual, Mode=OneWay}"
                                    IsTabStop="False"
                                    Padding="0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextSecondary}"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontFamily="{StaticResource AppIconFont}"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextSecondary}"
                                    Text="{x:Bind Chevron, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                        <ItemsControl
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Margin="6,0,0,0"
                            ItemTemplate="{StaticResource CategoryTemplate}"
                            ItemsSource="{x:Bind Items}"
                            Visibility="{x:Bind ChildrenVisibility, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>

                <!-- 单词：网格卡片 -->
                <DataTemplate x:Key="GridCardTemplate" x:DataType="vm:WordView">
                    <Grid
                        Width="236"
                        Margin="0,0,16,16"
                        RightTapped="OnCardRightTapped">
                        <Border Style="{StaticResource WordCard}" Visibility="{x:Bind CardVisibility}">
                            <Grid>
                                <StackPanel Spacing="1">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                        <TextBlock
                                            Style="{StaticResource CardWord}"
                                            Text="{x:Bind Word}"
                                            VerticalAlignment="Bottom" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Bottom">
                                            <TextBlock
                                                FontFamily="{StaticResource AppTextFont}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextTertiary}"
                                                Text="{x:Bind Nature}"
                                                Visibility="{x:Bind NatureVisibility}" />
                                            <TextBlock
                                                FontFamily="{StaticResource AppTextFont}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondary}"
                                                Text="{x:Bind Pos}"
                                                Visibility="{x:Bind PosVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource CardMeaning}"
                                        Text="{x:Bind Meaning}"
                                        Visibility="{x:Bind MeaningVisibility}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource CardMuted}"
                                        Text="{x:Bind Pronunciation}"
                                        Visibility="{x:Bind PronunciationVisibility}" />
                                    <Grid
                                        Margin="0,2,24,0"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8"
                                        Visibility="{x:Bind RelatedVisibility}">
                                        <TextBlock
                                            Style="{StaticResource CardRelated}"
                                            Text="{x:Bind Related}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="{StaticResource AppTextFont}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextTertiary}"
                                            Text="{x:Bind RelatedUsage}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind RelatedUsageVisibility}" />
                                    </Grid>
                                </StackPanel>
                                <Border
                                    Background="{x:Bind MarkFill}"
                                    Style="{StaticResource BadgeCircle}"
                                    Visibility="{x:Bind MarkVisibility}">
                                    <TextBlock
                                        FontFamily="{StaticResource AppIconFont}"
                                        FontSize="13"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind MarkGlyph}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            Height="118"
                            PointerEntered="OnAddTileEnter"
                            PointerExited="OnAddTileExit"
                            Style="{StaticResource AddTile}"
                            Tapped="OnAddTileTapped"
                            Visibility="{x:Bind PlaceholderVisibility}">
                            <TextBlock
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="22"
                                Foreground="{ThemeResource Accent}"
                                HorizontalAlignment="Center"
                                Text="&#x10017C;"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>

                <!-- 单词：列表行 -->
                <DataTemplate x:Key="ListRowTemplate" x:DataType="vm:WordView">
                    <Grid
                        Margin="0,0,0,6"
                        RightTapped="OnCardRightTapped">
                        <Border
                            Padding="16,9,16,9"
                            Style="{StaticResource WordCard}"
                            Visibility="{x:Bind CardVisibility}">
                            <!-- 词头和状态点各钉一列，中间所有元素装进一条可横向拖动的带子。
                                 眼睛菜单关掉某段时它整段收起，不再留下固定列宽的空档；
                                 带子的自然宽度超过可视宽度时就能左右拖着看全。 -->
                            <Grid ColumnDefinitions="230,*,Auto" ColumnSpacing="14">
                                <TextBlock
                                    Style="{StaticResource CardWord}"
                                    Text="{x:Bind Word}"
                                    VerticalAlignment="Center" />
                                <ScrollViewer
                                    Grid.Column="1"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Enabled"
                                    IsTabStop="False"
                                    SizeChanged="OnRowStripSizeChanged"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <!-- 指针事件挂在带子的内容上而不是 ScrollViewer 上：
                                         ScrollViewer 的类处理会在实例处理器之前把 PointerPressed
                                         标成已处理（实测挂在它身上一次都不回调），而事件从内容
                                         往上冒，先经过这里。Background 要有，否则空白处不命中。 -->
                                    <Grid
                                        Background="Transparent"
                                        ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                                        ColumnSpacing="14"
                                        PointerPressed="OnRowStripPanPressed"
                                        Tapped="OnRowStripTapped">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind MetaVisibility}">
                                            <TextBlock
                                                FontFamily="{StaticResource AppTextFont}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextTertiary}"
                                                Text="{x:Bind Nature}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind NatureVisibility}" />
                                            <TextBlock
                                                FontFamily="{StaticResource AppTextFont}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondary}"
                                                Text="{x:Bind Pos}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind PosVisibility}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="{StaticResource AppTextFont}"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextPrimary}"
                                            Text="{x:Bind Meaning}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind MeaningVisibility}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            FontFamily="{StaticResource AppTextFont}"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextSecondary}"
                                            Text="{x:Bind Pronunciation}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind PronunciationVisibility}" />
                                        <StackPanel
                                            Grid.Column="4"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind RelatedVisibility}">
                                            <TextBlock
                                                FontFamily="{StaticResource AppTextFont}"
                                                FontSize="13"
                                                Foreground="{ThemeResource Accent}"
                                                MaxWidth="320"
                                                Text="{x:Bind Related}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontFamily="{StaticResource AppTextFont}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextTertiary}"
                                                Text="{x:Bind RelatedUsage}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind RelatedUsageVisibility}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="5"
                                            FontFamily="{StaticResource AppTextFont}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextTertiary}"
                                            LineHeight="16"
                                            MaxHeight="32"
                                            MaxLines="2"
                                            MaxWidth="420"
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind DescriptionVisibility}" />
                                    </Grid>
                                </ScrollViewer>
                                <Border
                                    Grid.Column="2"
                                    Background="{x:Bind MarkFill}"
                                    Style="{StaticResource BadgeCircle}"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind RowMarkVisibility}">
                                    <TextBlock
                                        FontFamily="{StaticResource AppIconFont}"
                                        FontSize="13"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind MarkGlyph}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border
                            Height="46"
                            PointerEntered="OnAddTileEnter"
                            PointerExited="OnAddTileExit"
                            Style="{StaticResource AddTile}"
                            Tapped="OnAddTileTapped"
                            Visibility="{x:Bind PlaceholderVisibility}">
                            <TextBlock
                                Margin="16,0,0,0"
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="16"
                                Foreground="{ThemeResource Accent}"
                                HorizontalAlignment="Left"
                                Text="&#x10017C;"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>

                <!-- 自适应卡片：按内容高度排版，变体和描述完整展示 -->
                <DataTemplate x:Key="AdaptiveCardTemplate" x:DataType="vm:WordView">
                    <Grid
                        HorizontalAlignment="Stretch"
                        RightTapped="OnCardRightTapped"
                        Tapped="OnAdaptiveCardTapped">
                        <Border
                            Padding="17,14,17,13"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource WordCard}"
                            Visibility="{x:Bind CardVisibility}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                                    <TextBlock
                                        Style="{StaticResource CardWord}"
                                        Text="{x:Bind Word}"
                                        TextTrimming="None"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Bottom"
                                        Visibility="{x:Bind MetaVisibility}">
                                        <TextBlock
                                            FontFamily="{StaticResource AppTextFont}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextTertiary}"
                                            Text="{x:Bind Nature}"
                                            Visibility="{x:Bind NatureVisibility}" />
                                        <TextBlock
                                            FontFamily="{StaticResource AppTextFont}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextSecondary}"
                                            Text="{x:Bind Pos}"
                                            Visibility="{x:Bind PosVisibility}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{x:Bind DetailVisibility}">
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="{StaticResource AppTextFont}"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource TextPrimary}"
                                        Text="{x:Bind Meaning}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind MeaningVisibility}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontFamily="{StaticResource AppTextFont}"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextSecondary}"
                                        Text="{x:Bind Pronunciation}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind PronunciationVisibility}" />

                                    <StackPanel Margin="0,13,0,0" Visibility="{x:Bind RelatedFormsVisibility}">
                                        <TextBlock Style="{StaticResource CardSectionLabel}" Text="VARIANTS" />
                                        <Grid
                                            Margin="0,5,0,2"
                                            ColumnDefinitions="*,84"
                                            ColumnSpacing="10">
                                            <TextBlock Style="{StaticResource CardSectionLabel}" Text="FORM" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CardSectionLabel}"
                                                Text="NATURE" />
                                        </Grid>
                                        <ItemsControl
                                            Margin="0,1,0,0"
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{x:Bind RelatedForms}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:RelatedForm">
                                                    <Grid
                                                        Margin="0,2,0,2"
                                                        HorizontalAlignment="Stretch"
                                                        ColumnDefinitions="*,84"
                                                        ColumnSpacing="10">
                                                        <TextBlock
                                                            FontFamily="{StaticResource AppTextFont}"
                                                            FontSize="13"
                                                            Foreground="{ThemeResource Accent}"
                                                            Text="{x:Bind Form}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="{StaticResource AppTextFont}"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextTertiary}"
                                                            Text="{x:Bind Nature}"
                                                            TextAlignment="Right"
                                                            TextWrapping="Wrap"
                                                            VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,13,0,0" Visibility="{x:Bind DescriptionVisibility}">
                                        <TextBlock Style="{StaticResource CardSectionLabel}" Text="DESCRIPTION" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontFamily="{StaticResource AppTextFont}"
                                            FontSize="12.5"
                                            Foreground="{ThemeResource TextSecondary}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Margin="0,14,0,0" Visibility="{x:Bind MarkVisibility}">
                                        <Border
                                            Background="{x:Bind MarkFill}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource BadgeCircle}"
                                            ToolTipService.ToolTip="Memory status"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="{StaticResource AppIconFont}"
                                                FontSize="13"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                Text="{x:Bind MarkGlyph}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Height="118"
                            PointerEntered="OnAddTileEnter"
                            PointerExited="OnAddTileExit"
                            Style="{StaticResource AddTile}"
                            Tapped="OnAddTileTapped"
                            Visibility="{x:Bind PlaceholderVisibility}">
                            <TextBlock
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="22"
                                Foreground="{ThemeResource Accent}"
                                HorizontalAlignment="Center"
                                Text="&#x10017C;"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="AdaptiveGroupTemplate" x:DataType="vm:WordGroup">
                    <StackPanel
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch">
                        <ContentControl
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource WordGroupHeaderTemplate}" />
                        <ItemsControl
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding}"
                            ItemTemplate="{StaticResource AdaptiveCardTemplate}"
                            ItemsPanel="{StaticResource MasonryPanelTemplate}" />
                    </StackPanel>
                </DataTemplate>

            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏底色一直顶到窗口上沿，红绿灯浮在它上面：桌面 acrylic 毛玻璃 + 主题色调层 -->
            <Border
                x:Name="SidebarSurface"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="{x:Bind Vm.SidebarWidth, Mode=OneWay}"
                Canvas.ZIndex="1"
                CornerRadius="{StaticResource RWinLeft}">
                <Grid>
                    <SystemBackdropElement x:Name="SidebarGlass" CornerRadius="18,0,0,18">
                        <SystemBackdropElement.SystemBackdrop>
                            <DesktopAcrylicBackdrop />
                        </SystemBackdropElement.SystemBackdrop>
                    </SystemBackdropElement>
                    <Border x:Name="SidebarVeil" Background="{ThemeResource SidebarTint}" CornerRadius="{StaticResource RWinLeft}" />
                </Grid>
            </Border>

            <Border
                x:Name="ContentSurface"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Background="{ThemeResource ContentBg}"
                CornerRadius="{StaticResource RWinRight}" />
            <!-- ==================== 侧栏 ==================== -->
            <Grid
                x:Name="SidebarContent"
                Grid.Row="1"
                Grid.Column="0"
                Visibility="{x:Bind Vm.SidebarVisibility, Mode=OneWay}"
                Width="{x:Bind Vm.SidebarWidth, Mode=OneWay}"
                Canvas.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="SidebarScroll"
                    Grid.Row="0"
                    Padding="14,0,8,0"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="SidebarScrollContent" Spacing="1">

                        <Button
                            x:Name="StartTodayButton"
                            Height="36"
                            Margin="2,0,2,10"
                            VerticalAlignment="Top"
                            Click="OnStartToday"
                            Content="Start today"
                            Style="{StaticResource PrimaryPillButton}"
                            Visibility="{x:Bind Vm.StartTodayVisibility, Mode=OneWay}" />

                        <Grid Margin="2,4,2,6">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Statistic" />
                            <Button
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnEditLanguages"
                                Content="&#x10020E;"
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="11"
                                Style="{StaticResource TinyIconButton}"
                                ToolTipService.ToolTip="Add / edit languages" />
                        </Grid>

                        <ItemsControl
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ItemTemplate="{StaticResource LangTemplate}"
                            ItemsSource="{x:Bind Vm.LangNodes}" />

                        <Grid Margin="2,16,2,6">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Categories" />
                            <Button
                                x:Name="AddCategoryButton"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnAddCategory"
                                Content="&#x10017C;"
                                FontFamily="{StaticResource AppIconFont}"
                                FontSize="11"
                                Style="{StaticResource TinyIconButton}" />
                        </Grid>

                        <ItemsControl
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ItemTemplate="{StaticResource CategoryGroupTemplate}"
                            ItemsSource="{x:Bind Vm.CategoryGroups}" />

                        <TextBlock Margin="2,18,0,8" Style="{StaticResource SectionHeader}" Text="Heat Map" />
                        <controls:HeatMapView x:Name="Heat" Margin="0,0,2,4" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="10,6,16,12">
                    <Button
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Left"
                        Click="OnOpenSettings"
                        Content="&#x1008CB;"
                        FontFamily="{StaticResource AppIconFont}"
                        FontSize="14"
                        Style="{StaticResource TinyIconButton}"
                        ToolTipService.ToolTip="Settings" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppDisplayFont}"
                        FontSize="13"
                        FontWeight="Semibold"
                        Foreground="{ThemeResource TextPrimary}"
                        Text="{x:Bind Vm.PerDayLabel, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- ==================== 单词区 ==================== -->
            <!-- 顶到窗口上沿，卡片滚动时从标题条的毛玻璃下面穿过去；右边留到 0，
                 让滚动条贴着窗口右沿，卡片的内缩改由 ListView 的 Padding 负责。 -->
            <Grid x:Name="WordsHost" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="26,0,0,0">
                <!-- 分组 ListView 在运行时换 ItemsPanel 会让 WinUI 原生崩溃，
                     所以网格/列表各用一个 ListView，只切可见性。 -->
                <ListView
                    x:Name="WordList"
                    ItemTemplate="{StaticResource GridCardTemplate}"
                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                    IsItemClickEnabled="True"
                    ItemClick="OnWordItemClick"
                    Style="{StaticResource WordListBase}">
                    <ListView.Header>
                        <Border Height="52" />
                    </ListView.Header>
                    <ListView.GroupStyle>
                        <GroupStyle
                            HeaderContainerStyle="{StaticResource WordGroupHeaderContainer}"
                            HeaderTemplate="{StaticResource WordGroupHeaderTemplate}" />
                    </ListView.GroupStyle>
                </ListView>

                <ListView
                    x:Name="RowList"
                    ItemTemplate="{StaticResource ListRowTemplate}"
                    ItemsPanel="{StaticResource StackPanelTemplate}"
                    IsItemClickEnabled="True"
                    ItemClick="OnWordItemClick"
                    PointerCanceled="OnRowStripPanEnded"
                    PointerMoved="OnRowStripPanMoved"
                    PointerReleased="OnRowStripPanEnded"
                    Style="{StaticResource WordListBase}"
                    Visibility="Collapsed">
                    <ListView.Header>
                        <Border Height="52" />
                    </ListView.Header>
                    <ListView.GroupStyle>
                        <GroupStyle
                            HeaderContainerStyle="{StaticResource WordGroupHeaderContainer}"
                            HeaderTemplate="{StaticResource WordGroupHeaderTemplate}" />
                    </ListView.GroupStyle>
                </ListView>

                <ScrollViewer
                    x:Name="AdaptiveScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    Visibility="Collapsed">
                    <ItemsControl
                        x:Name="AdaptiveGroups"
                        Margin="0,52,14,20"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ItemTemplate="{StaticResource AdaptiveGroupTemplate}" />
                </ScrollViewer>

                <TextBlock
                    x:Name="EmptyHint"
                    Margin="0,48,22,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource AppTextFont}"
                    FontSize="14"
                    Foreground="{ThemeResource TextTertiary}"
                    Text="No words here yet — click the + card to add one."
                    Visibility="{x:Bind Vm.EmptyVisibility, Mode=OneWay}" />
            </Grid>

            <!-- ==================== 标题栏（拖拽区） ==================== -->
            <Grid x:Name="DragBar" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Canvas.ZIndex="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 标题条毛玻璃：模糊的是底下这片单词表，不是桌面；侧栏那一格留给桌面 acrylic -->
                <Border
                    x:Name="HeaderGlass"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Background="{ThemeResource HeaderAcrylic}"
                    CornerRadius="{StaticResource RWinTopRight}">
                    <Border x:Name="HeaderVeilBorder" Background="{ThemeResource HeaderVeil}" CornerRadius="{StaticResource RWinTopRight}" />
                </Border>

                <Grid
                    Width="{x:Bind Vm.SidebarWidth, Mode=OneWay}"
                    MinWidth="110">
                    <StackPanel
                        x:Name="TrafficLights"
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        PointerEntered="OnTrafficEntered"
                        PointerExited="OnTrafficExited"
                        Spacing="8">
                        <Button
                            x:Name="TrafficClose"
                            Background="#FF5F57"
                            BorderBrush="#26000000"
                            Click="OnTrafficClose"
                            Content="&#x100184;"
                            Style="{StaticResource TrafficButton}" />
                        <Button
                            x:Name="TrafficMin"
                            Background="#FEBC2E"
                            BorderBrush="#26000000"
                            Click="OnTrafficMinimize"
                            Content="&#x10017D;"
                            Style="{StaticResource TrafficButton}" />
                        <Button
                            x:Name="TrafficMax"
                            Background="#28C840"
                            BorderBrush="#26000000"
                            Click="OnTrafficMaximize"
                            Content="&#x100C76;"
                            Style="{StaticResource TrafficButton}" />
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        x:Name="SidebarToggleButton"
                        Click="OnToggleSidebar"
                        Content="&#x100C31;"
                        FontFamily="{StaticResource AppIconFont}"
                        FontSize="19"
                        Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Show / hide sidebar" />
                    <TextBlock
                        VerticalAlignment="Center"
                        MinWidth="0"
                        Style="{StaticResource PageTitle}"
                        Text="{x:Bind Vm.HeaderTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    x:Name="ToolButtons"
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">

                    <Border
                        x:Name="SearchHost"
                        Width="200"
                        Margin="0,0,6,0"
                        Style="{StaticResource PillHost}"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="SearchBox"
                            Width="188"
                            KeyDown="OnSearchKeyDown"
                            LostFocus="OnSearchLostFocus"
                            PlaceholderText="word or meaning"
                            Style="{StaticResource PillTextBox}"
                            TextChanged="OnSearchChanged" />
                    </Border>

                    <Button
                        x:Name="LayoutButton"
                        Click="OnToggleLayout"
                        Content="&#x1002F2;"
                        Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="List / grid view" />
                    <Button
                        x:Name="AdaptiveButton"
                        AutomationProperties.Name="Adaptive cards"
                        Click="OnToggleAdaptive"
                        Content="&#x1001F4;"
                        Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Adaptive cards (auto height)" />
                    <Button
                        x:Name="SearchButton"
                        Click="OnToggleSearch"
                        Content="&#x1002AB;"
                        Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Search" />
                    <Button
                        x:Name="FocusButton"
                        Click="OnToggleFocus"
                        Content="&#x1002EE;"
                        RightTapped="OnFocusRightTapped"
                        Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Words only — right click to pick card fields" />
                </StackPanel>
            </Grid>

            <!-- 侧栏宽度拖拽条：压在所有内容之上、弹窗遮罩之下 -->
            <controls:SidebarHandle
                x:Name="SidebarSplitter"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="7"
                Margin="-3,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                PointerEntered="OnSplitterEnter"
                PointerExited="OnSplitterExit"
                PointerPressed="OnSplitterPressed"
                Visibility="{x:Bind Vm.SidebarVisibility, Mode=OneWay}" />

            <!-- ==================== 编辑弹窗 ==================== -->
            <Border
                x:Name="EditorScrim"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{ThemeResource ScrimBg}"
                Canvas.ZIndex="3"
                CornerRadius="18"
                Tapped="OnScrimTapped"
                Visibility="Collapsed">
                <Grid Margin="24,0,24,0">
                    <!-- MaxWidth 而不是 Width：窗口比弹窗还窄时（缩放 1.25 下弹窗就有 687 物理像素宽），
                         定宽会被窗口右沿直接切掉，右边的 + 按钮连点都点不到。 -->
                    <controls:WordEditor
                        x:Name="Editor"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ==================== 设置弹窗 ==================== -->
            <Border
                x:Name="SettingsScrim"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{ThemeResource ScrimBg}"
                Canvas.ZIndex="3"
                CornerRadius="18"
                Tapped="OnSettingsScrimTapped"
                Visibility="Collapsed">
                <Grid>
                    <controls:SettingsPanel
                        x:Name="Settings"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
